# Safety net for hosts where the document root cannot point at /public
# (shared cPanel subdomain folders, or this repo under a WAMP web root).
# The correct setup is still: document root = <app>/public.

Options -Indexes

# The parent site on the shared host sends its own security headers with
# "Header always set"; re-assert this app's values so they win.
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let AutoSSL / ACME domain validation through.
    RewriteRule ^\.well-known/ - [L]

    # Never serve anything outside public/: dotfiles, source, config, logs, dependencies.
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(app|bootstrap|config|database|docs|lang|node_modules|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|phpstan\.neon|pint\.json|vite\.config\.ts|tsconfig\.json|.*\.md)$ - [F,L,NC]

    # Everything else is served from public/.
    # Note: this only makes real files under public/ reachable this way
    # (e.g. /index.php). Laravel reads its route path from REQUEST_URI, so a
    # rewritten /about still arrives as /about, outside this app's
    # /aesthetic/public base path, and 404s. The site URL is the one that
    # ends in /public -- see CLAUDE.md.
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
